rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidStudySession(data) {
      return data.keys().hasAll(['userId', 'date', 'subject', 'completed', 'type']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.date is string && data.date.size() <= 30 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.completed is bool &&
             data.type is string && data.type.size() <= 30 &&
             (data.keys().hasAny(['title']) == false || (data.title is string && data.title.size() <= 200)) &&
             (data.keys().hasAny(['updatedAt']) == false || data.updatedAt == request.time) &&
             (data.keys().hasAny(['createdAt']) == false || data.createdAt == request.time);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow list, get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId && isValidStudySession(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId && isValidStudySession(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'title', 'type', 'subject', 'date', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId;
    }
  }
}
