# Chave da API Groq (gratuita) — obtida em https://console.groq.com
# Modelo usado: llama3-70b-8192 (alta velocidade e qualidade)
# Adicionar no painel da Vercel: Settings → Environment Variables
GROQ_API_KEY="your_groq_api_key_here"

# (Opcional) Service Account do Firebase Admin para cache server-side no Firestore
# Obtenha em: Firebase Console → Configurações do Projeto → Contas de Serviço → Gerar nova chave privada
# Cole o conteúdo do JSON aqui como string (sem quebras de linha)
FIREBASE_SERVICE_ACCOUNT=""
