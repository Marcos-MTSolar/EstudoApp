rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidRecord(data) {
      return data.userId is string && data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /users/{userId}/{collectionName}/{docId} {
      allow list, get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId && isValidRecord(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId && isValidRecord(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
    }
  }
}
